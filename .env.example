APP_NAME=Elomiah
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=altere-esta-chave-em-producao-32chars
# InfinityFree / subpasta: se Loja e Entrar abrirem a home, use 1
# APP_QUERY_ROUTES=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=elomiah
DB_USER=root
DB_PASS=sua-senha-mysql

# Em produção (HTTPS) defina SESSION_SECURE=1
SESSION_SECURE=0

# WhatsApp da loja (somente números, com DDI)
WHATSAPP=5571984916767

# Marketplace (compra externa, se um produto não for pela sacola)
SHOPEE_URL=https://collshp.com/geovanaferreira030789?view=storefront

# Pix direto (chave aleatória)
PIX_CHAVE=0a27cf9a-cc18-4314-892c-ce9772939c84
PIX_NOME=ELOMIAH
PIX_CIDADE=SAO PAULO

# Conta Nubank para liquidação (cartão não deposita direto nesta conta)
BANCO_NOME=Nu Pagamentos S.A.
BANCO_CODIGO=0260
BANCO_AGENCIA=0001
BANCO_CONTA=16993107-6

# Dados do emitente no recibo de compra (opcional)
LOJA_RAZAO=Elomiah
LOJA_CNPJ=
LOJA_IE=
LOJA_ENDERECO=

# Mercado Pago — cartão nesta página (e Pix automático, se quiser)
# Produção: APP_USR-...  | Testes: TEST-...
# Painel: https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# URL HTTPS pública (domínio ou ngrok). Vazia = APP_URL
MERCADOPAGO_PUBLIC_URL=

# E-mail transacional (pedido recebido, pago, enviado)
# Sem MAIL_HOST o site tenta mail() e registra em storage/logs/mail.log
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=olivia.t@example.org
MAIL_FROM_NAME=Elomiah
MAIL_ADMIN=admin@elomiah.com
# MAIL_VERIFY_PEER=0
